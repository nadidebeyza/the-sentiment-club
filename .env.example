GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash is unavailable for new accounts; use gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
# Numeric Instagram Business Account ID (NOT username or domain)
INSTAGRAM_ACCOUNT_ID=12345678901234567
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token
# Optional fallback when Catbox upload fails
IMGUR_CLIENT_ID=your_imgur_client_id
